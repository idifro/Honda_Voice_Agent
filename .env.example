# Backend config template (SPEC §13). Copy to .env and fill in. Never commit .env.
# Leave a value empty (not "<key>") when you don't have it yet.

# --- LiveKit Cloud (Phases 0–9) — Project Settings → Keys --------------------
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=<API key, starts with "API">
LIVEKIT_API_SECRET=<secret>

# --- Sarvam STT/TTS ----------------------------------------------------------
SARVAM_API_KEY=<key>
STT_MODEL=saaras:v4              # saaras:v3 | saaras:v4
STT_MODE=codemix                 # codemix | transcribe | translit | verbatim — codemix wins (2026-10-15 test)
STT_LANGUAGE=unknown             # auto-detect; per-turn language decides the reply language (SPEC §4.1)
TTS_MODEL=bulbul:v4-flash        # bulbul:v3 | bulbul:v4-flash
TTS_SPEAKER=aarti_hi_customer    # female → prompts use feminine verb forms; alternatives: shubh_enhi_ads, ishita_enhi_customer
SARVAM_TTS_DICT_ID=              # optional pronunciation dictionary
SUPPORTED_LANGUAGES=hi-IN,en-IN,ta-IN,te-IN,ml-IN,kn-IN
GREETING_LANGUAGE=ta-IN          # greeting is Tanglish; switches as soon as the caller speaks

# --- LLM (SPEC §4) -------------------------------------------------------------
LLM_PROVIDER=azure               # azure | openai | groq | sarvam
LLM_MODEL=gpt-5.4-mini           # underlying model name
LLM_REASONING_EFFORT=none        # none | minimal (gpt-5 / gpt-5-mini only); ignored for gpt-4.1-*
LLM_MAX_TOKENS=150               # max_completion_tokens per reply (reasoning tokens count against it)

# Azure OpenAI: resource in South India; deployments Global Standard with a content
# filter whose Streaming mode = Asynchronous Filter (default filter adds ~300 ms TTFT).
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key 1 or key 2 from Keys and Endpoint>
AZURE_OPENAI_DEPLOYMENT=<deployment name, e.g. voice-gpt-5.4-mini>
AZURE_OPENAI_DEPLOYMENT_ALT=<comparison deployment for Phase 1, e.g. voice-gpt-4.1-mini>
AZURE_OPENAI_API_VERSION=2024-12-01-preview   # needs ≥ 2024-02-01 for async filter
LLM_ATTEMPT_TIMEOUT_S=4          # abandon + retry a stalled LLM request (no bytes this long)
LLM_MAX_RETRY=1
# Optional fallback deployment (automatic switch on errors/429/stalls, switches back when the primary recovers).
# Endpoint and key default to the primary's; set them for a deployment in another region/resource.
AZURE_OPENAI_FALLBACK_DEPLOYMENT=
AZURE_OPENAI_FALLBACK_MODEL=
AZURE_OPENAI_FALLBACK_ENDPOINT=
AZURE_OPENAI_FALLBACK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Decision layer (Phase 7) — Laya, self-hosted (services/laya/run.sh, SPEC §23) ---
DECISION_PROVIDER=laya           # laya | llm_fallback
DECISION_MODE=off                # off | shadow | enforce
DECISION_TIMEOUT_MS=600
LAYA_BASE_URL=http://127.0.0.1:8100   # local laya-serve, Jev-compatible POST /v1/systemone
LAYA_MODEL=multilingual          # Laya checkpoint for Indic/code-mixed turns: multilingual | english
LAYA_API_KEY=                    # only if laya-serve is started with LAYA_API_KEY

# --- Optional API service (§22) — when enabled, the frontend calls it instead of the DB
API_BASE_URL=                    # e.g. http://localhost:8000; empty = Next.js routes read the DB
API_SERVICE_TOKEN=<shared secret between Next.js server and FastAPI>

# --- LangGraph (Phase 8) — native | langgraph --------------------------------
ORCHESTRATOR=native
LG_ROUTER=decision               # decision | rules | llm

# --- Database: Supabase session pooler (IPv4), Mumbai (ap-south-1) -----------
# Supabase → Connect → Session pooler. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt   # verify the DB TLS certificate; empty for local Postgres (Phase 11)

SHOWROOM_ID=demo-showroom
BUSINESS_TZ=Asia/Kolkata

# --- Google Calendar mirror (Phase 4, §11) -----------------------------------
LOG_FILE=logs/worker.log         # INFO log file during development (empty: off)
MAX_CONCURRENT_CALLS=3           # calls per worker process at once (quota protection)
HOLD_AFTER_S=2                   # say the hold line after this much thinking
NOISE_CANCELLATION=bvc           # bvc: also removes background voices (LiveKit voice isolation: 100 free min/month, then billed) | nc: noise only, free | off
ADVISOR=on                       # sales advisor (SPEC §20): on (suggested moves) | shadow (signals recorded only) | off
SIGNAL_PROVIDER=nano             # nano (Azure, SIGNAL_DEPLOYMENT or the fallback deployment) | laya (SPEC §23)
SIGNAL_DEPLOYMENT=               # empty: AZURE_OPENAI_FALLBACK_DEPLOYMENT
MAX_CALL_MINUTES=10              # calls end after this (cost limit, Phase 5)
CALENDAR_SYNC=on                 # on | off (§24.1)
GOOGLE_CALENDAR_ID=<calendar-id>@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google_service_account.json

# --- Local infrastructure (Phases 10–11, §24) — uncomment to switch ----------
# LIVEKIT_URL=ws://localhost:7880          # Phase 10; dev keys are local-only
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# POSTGRES_PASSWORD=<choose a local password>                                  # Phase 11
# DATABASE_URL=postgresql://postgres:<same password>@localhost:5432/honda_voice
