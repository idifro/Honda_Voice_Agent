# Frontend config template (SPEC §12, §13). Copy to .env.local. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the Next.js server (rule 9).

LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud   # same URL; safe to expose
LIVEKIT_API_KEY=<API key, starts with "API">
LIVEKIT_API_SECRET=<secret>
AGENT_NAME=honda-sales            # the worker's agent_name; dispatched explicitly by /api/token

# Read-only role from migration 004, NOT the postgres admin URL. Written by
# `uv run python scripts/set_frontend_db_password.py`. Leave empty when API_BASE_URL is set.
DATABASE_URL=postgresql://frontend_reader.<project-ref>:<generated>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

DATABASE_CA_CERT=../certs/supabase-prod-ca-2021.crt   # verify the DB TLS cert (path from frontend/)

DEMO_PASSCODE=<choose one; share it only with demo users>
SESSION_SECRET=<random, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Optional API service (§22). When set, server routes proxy to FastAPI instead of reading the DB.
API_BASE_URL=
API_SERVICE_TOKEN=<same value as backend .env>
