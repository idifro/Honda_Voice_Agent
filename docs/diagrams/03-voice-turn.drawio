<mxfile host="app.diagrams.net">
  <diagram id="03 Voice turn" name="03 Voice turn">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1600" pageHeight="1100">
